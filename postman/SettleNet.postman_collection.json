    {
      "name": "7. Error examples",
      "description": "Each request is expected to fail on purpose. A passing test means the API rejected it correctly.",
      "item": [
        {
          "name": "401: no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/me",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "404: group that does not exist",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/groups/999999"
          }
        },
        {
          "name": "400: negative amount",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Bad\",\n  \"amount\": \"-50.00\",\n  \"paid_by\": {{userId}},\n  \"split_method\": \"equal\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400: exact split does not add up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Bad\",\n  \"amount\": \"100.00\",\n  \"paid_by\": {{userId}},\n  \"split_method\": \"exact\",\n  \"splits\": [\n    { \"user_id\": {{userId}}, \"value\": \"60.00\" },\n    { \"user_id\": {{memberId}}, \"value\": \"30.00\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400: percentages do not total 100",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Bad\",\n  \"amount\": \"100.00\",\n  \"paid_by\": {{userId}},\n  \"split_method\": \"percentage\",\n  \"splits\": [\n    { \"user_id\": {{userId}}, \"value\": \"60\" },\n    { \"user_id\": {{memberId}}, \"value\": \"30\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "409: idempotency key reused with a different request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{expenseKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
            "description": "Reuses {{expenseKey}} from the first expense, but with a different amount.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Dinner at the beach shack\",\n  \"category\": \"food\",\n  \"amount\": \"5555.00\",\n  \"paid_by\": {{userId}},\n  \"split_method\": \"equal\",\n  \"expense_date\": \"2026-10-03\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
